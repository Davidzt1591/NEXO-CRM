{
  "name": "nexo",
  "version": "1.0.0",
  "description": "Plataforma omnicanal para gestión de chats de WhatsApp con IA",
  "main": "server.js",
  "scripts": {
    "prestart": "node ../scripts/check-node-runtime.js && npm run verify:production-deps",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "audit:production": "npm audit --omit=dev --omit=optional --audit-level=high",
    "install:production": "npm ci --omit=dev --omit=optional",
    "verify:production-deps": "node ../scripts/verify-production-dependencies.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "keywords": [
    "whatsapp",
    "chat",
    "ia",
    "sqlite",
    "salesforce",
    "gemini"
  ],
  "author": "Magneto - William Zapata",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12 <23",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.99.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "proxy-addr": "^2.0.7",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "sql.js": "^1.14.1",
    "whatsapp-web.js": "github:pedroslopez/whatsapp-web.js",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "ws": "8.21.0",
    "express": {
      "body-parser": "2.3.0",
      "qs": "6.15.3"
    },
    "router": {
      "path-to-regexp": "8.4.2"
    },
    "basic-ftp": "5.3.1",
    "form-data": "4.0.6",
    "ip-address": "10.2.0",
    "js-yaml": "4.3.0",
    "whatsapp-web.js": {
      "archiver": "8.0.0"
    },
    "minimatch@10.2.4": {
      "brace-expansion": "5.0.8"
    }
  }
}

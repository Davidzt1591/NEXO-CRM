{
  "name": "nexo",
  "version": "1.0.0",
  "description": "Plataforma omnicanal para gestión de chats de WhatsApp con IA",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:backend": "cd backend && nodemon server.js",
    "diagnose": "node scripts/diagnose-nexo.js",
    "test:focused": "node scripts/check-focused-tests.js",
    "test:diagnose": "node --test scripts/*.test.js",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "verify": "npm run test:focused && npm run test:diagnose && npm run test:backend && npm run test:frontend",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "whatsapp",
    "chat",
    "ia",
    "supabase",
    "gemini"
  ],
  "author": "Magneto - William Zapata",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.99.2",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
